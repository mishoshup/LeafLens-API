{
  "extends": ["@commitlint/config-conventional"],
  "rules": {
    "scope-enum": [2, "always", [
      "backend",
      "auth",
      "api",
      "db",
      "ghs",
      "rpc",
      "ws",
      "docker",
      "ci",
      "deps",
      "config",
      "tests",
      "middleware"
    ]],
    "scope-case": [2, "always", "lower-case"],
    "type-enum": [2, "always", [
      "feat",
      "fix",
      "chore",
      "refactor",
      "docs",
      "style",
      "test",
      "build",
      "ci",
      "perf",
      "revert"
    ]]
  }
}
