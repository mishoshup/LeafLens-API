# Auto detect text files and perform LF normalization
* text=auto

# Python
*.py text diff=python
*.pyi text diff=python
*.pyx text diff=python

# Config
*.toml text
*.yaml text
*.yml text
*.json text
*.ini text
*.cfg text
*.env text

# Shell scripts (LF only — no CRLF)
*.sh text eol=lf
*.bash text eol=lf

# Markdown / docs
*.md text diff=markdown
*.txt text

# Docker
Dockerfile text
docker-compose*.yml text

# Git
.gitignore text
.gitattributes text

# Binary — no diff, no merge, no LF conversion
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg text
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.pyc binary
*.pyo binary
*.so binary
*.dylib binary

# Lock files — do not merge
poetry.lock -merge
package-lock.json -merge

# Ensure LF for CI scripts (Linux containers)
*.sh linguist-detectable=false
